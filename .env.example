# Copy to .env. On Vercel, set these in Project → Settings → Environment Variables.
#
# Backend base URL, WITHOUT /api (this app's services already call "/api/...").
#   Local:      http://localhost:5000
#   Production: https://<your-render-app>.onrender.com
# Note: the admin app's VITE_API_URL is the same URL WITH /api.
VITE_API_URL=http://localhost:5000

# --- Firebase (student Google sign-in) ---
# From Firebase Console → Project settings → General → Your apps → Web app.
# These are public by design (they ship in the browser bundle). Also add
# your Vercel domain under Authentication → Settings → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
